#!/usr/bin/env bash
# Pre-commit hook: runs the fast subset of .github/workflows/ci.yml, so the
# cheapest CI failures are caught locally before a push. Version sync runs
# first (cheap).
#
# Runs:    version sync, cargo fmt, clippy (all features, plus bubbles-dialogue
#          and bubbles-cli with no default features), rustdoc, file sizes.
# Skipped: cargo test, scripts/check-wasm.sh, the publish dry-runs, the
#          `bubbles check` smoke test, cargo-deny, the .NET P/Invoke smoke
#          test, the MSRV build, and the DCO sign-off check.
#
# A clean run here is therefore not a promise of green CI. Keep the two lists
# above in step with ci.yml and the gate tables in CONTRIBUTING.md.
#
# Install once with: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

fail() {
  echo -e "${RED}${BOLD}pre-commit:${RESET} $*" >&2
  exit 1
}

echo -e "${BOLD}pre-commit:${RESET} checking version sync (workspace, VERSION, README)..."
if ! bash scripts/check-version-sync.sh 2>&1; then
  echo ""
  fail "version drift. See RELEASING.md and align Cargo.toml, VERSION, and README."
fi

echo -e "${BOLD}pre-commit:${RESET} checking format..."
if ! cargo fmt --check 2>&1; then
  echo ""
  fail "rustfmt found unformatted code. Run \`cargo fmt\` and re-stage your changes."
fi

echo -e "${BOLD}pre-commit:${RESET} running clippy (workspace, all features)..."
if ! cargo clippy --workspace --all-features --all-targets -- -D warnings 2>&1; then
  echo ""
  fail "clippy reported errors. Fix them and re-stage your changes."
fi

echo -e "${BOLD}pre-commit:${RESET} running clippy (bubbles-dialogue, no default features)..."
if ! cargo clippy -p bubbles-dialogue --no-default-features --all-targets -- -D warnings 2>&1; then
  echo ""
  fail "clippy (no default features) reported errors. Fix them and re-stage your changes."
fi

echo -e "${BOLD}pre-commit:${RESET} running clippy (bubbles-cli, no default features)..."
if ! cargo clippy -p bubbles-cli --no-default-features --all-targets -- -D warnings 2>&1; then
  echo ""
  fail "clippy (bubbles-cli, no default features) reported errors. Fix them and re-stage your changes."
fi

echo -e "${BOLD}pre-commit:${RESET} running rustdoc (workspace)..."
if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps 2>&1; then
  echo ""
  fail "rustdoc reported errors. Fix them and re-stage your changes."
fi

echo -e "${BOLD}pre-commit:${RESET} checking file sizes..."
if ! bash scripts/check-file-sizes.sh 2>&1; then
  echo ""
  fail "file-size check failed. Split oversized files and re-stage your changes."
fi

echo -e "${GREEN}${BOLD}pre-commit:${RESET} all checks passed."
