#!/usr/bin/env bash
# Pre-commit hook: runs rustfmt and clippy to catch CI failures early.
# Install once with: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

fail() {
  echo -e "${RED}${BOLD}pre-commit:${RESET} $*" >&2
  exit 1
}

echo -e "${BOLD}pre-commit:${RESET} checking format..."
if ! cargo fmt --check 2>&1; then
  echo ""
  fail "rustfmt found unformatted code. Run \`cargo fmt\` and re-stage your changes."
fi

echo -e "${BOLD}pre-commit:${RESET} running clippy..."
if ! cargo clippy --all-features --all-targets -- -D warnings 2>&1; then
  echo ""
  fail "clippy reported errors. Fix them and re-stage your changes."
fi

echo -e "${GREEN}${BOLD}pre-commit:${RESET} all checks passed."
